# ==============================================================================
# Autonomous arXiv Paper Digest & QA Agent - Configuration
# ==============================================================================

# Preferred LLM Provider: 'gemini', 'groq', 'openai', 'ollama', 'openrouter', or 'mock'
LLM_PROVIDER=gemini

# Model Names (leave default or customize)
# For Gemini: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
# For OpenAI: gpt-4o-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini
# For Ollama: llama3.2, mistral, qwen2.5
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# API Keys (Provide at least one, or use LLM_PROVIDER=mock for offline testing)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Cache and Storage Directory
CACHE_DIR=./.cache_arxiv
